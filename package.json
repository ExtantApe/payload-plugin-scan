{
  "name": "@extantape/payload-plugin-scan",
  "version": "0.1.0",
  "description": "Scan for Payload: read barcodes and QR codes with a phone camera or a USB scanner, and answer scan links by who is signed in, without letting codes be probed.",
  "homepage": "https://github.com/ExtantApe/payload-plugin-scan#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/payload-plugin-scan/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "ecommerce",
    "barcode",
    "qr",
    "qr-code",
    "scanner",
    "camera",
    "code-128",
    "usb-scanner"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/payload-plugin-scan.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "import": "./dist/pages/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "leak-check": "bash scripts/leak-check.sh",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "payload": "^3.80.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "graphql": "^16.14.2",
    "jsdom": "^31.0.0",
    "mongodb-memory-server": "^11.3.0",
    "payload": "3.92.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
